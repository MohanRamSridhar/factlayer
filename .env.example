# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM backend selection -------------------------------------------------
# One of: anthropic | claude_cli | none
# anthropic  : uses the Anthropic API (needs ANTHROPIC_API_KEY). Recommended.
# claude_cli : shells out to a locally installed `claude` CLI. No API key needed.
# none       : no LLM at all; the deterministic heuristic extractor is used.
FACTLAYER_LLM=anthropic

ANTHROPIC_API_KEY=

# Model used for fact extraction (high volume, cheap model is fine)
FACTLAYER_EXTRACT_MODEL=claude-haiku-4-5-20251001
# Model used for relationship adjudication (low volume, needs more reasoning)
FACTLAYER_ADJUDICATE_MODEL=claude-sonnet-5

# --- Tuning ----------------------------------------------------------------
FACTLAYER_DB=data/factlayer.db
FACTLAYER_MAX_CONCURRENCY=8
