# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM backend selection -------------------------------------------------
# One of: gemini | anthropic | claude_cli | none | auto
# gemini     : Google Gemini REST API (needs GEMINI_API_KEY). Free tier. Default.
# anthropic  : Anthropic API (needs ANTHROPIC_API_KEY). Paid.
# claude_cli : shells out to a locally installed `claude` CLI. No key needed.
# none       : no LLM at all; ingestion, linking and adjudication still run.
# auto       : first backend above that has credentials.
FACTLAYER_LLM=gemini

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Extraction is high volume, so it runs on a lite model. Note that Gemini's free
# tier meters REQUESTS PER DAY per model, and the newest models are capped very
# low (gemini-3.8-flash allows 20/day). Lite models are far more generous, which
# is why one is the default here. Check your own limits at https://ai.dev/rate-limit
FACTLAYER_EXTRACT_MODEL=gemini-3.5-flash-lite
FACTLAYER_ADJUDICATE_MODEL=gemini-3.5-flash

# Requests per minute. The provider paces itself to stay under it.
# Set 0 to disable pacing on a paid key.
FACTLAYER_GEMINI_RPM=8
# Reasoning token budget. 0 disables thinking, which is right for extraction.
FACTLAYER_GEMINI_THINKING=0

# --- Alternative backends --------------------------------------------------
ANTHROPIC_API_KEY=

# --- Tuning ----------------------------------------------------------------
FACTLAYER_DB=data/factlayer.db
FACTLAYER_MAX_CONCURRENCY=4

# Pages are batched into one call, because the context window is huge and the
# free tier bills per request. These three decide how many requests a document
# costs: ~40k chars / 25 pages per call turns a 100-page filing into ~8 calls.
FACTLAYER_BATCH_CHARS=40000
FACTLAYER_BATCH_PAGES=25
FACTLAYER_MAX_OUTPUT_TOKENS=48000

# Hard cap on batches per document, highest density first. 0 means no cap.
FACTLAYER_MAX_UNITS_PER_DOC=14
# Pages below this information density are skipped before batching.
FACTLAYER_MIN_DENSITY=0.12
