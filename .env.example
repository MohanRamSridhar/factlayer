# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM backend selection -------------------------------------------------
# One of: gemini | anthropic | claude_cli | none | auto
# gemini     : Google Gemini REST API (needs GEMINI_API_KEY). Free tier. Default.
# anthropic  : Anthropic API (needs ANTHROPIC_API_KEY). Paid.
# claude_cli : shells out to a locally installed `claude` CLI. No key needed.
# none       : no LLM at all; the deterministic heuristic extractor is used.
# auto       : first backend above that has credentials.
FACTLAYER_LLM=gemini

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for fact extraction (high volume, cheap fast model is right)
FACTLAYER_EXTRACT_MODEL=gemini-3.8-flash
# Model used for relationship adjudication (low volume, needs more reasoning)
FACTLAYER_ADJUDICATE_MODEL=gemini-3.8-flash

# Free-tier request-per-minute cap. The provider paces itself to stay under it.
# Raise (or set 0 to disable pacing) on a paid key.
FACTLAYER_GEMINI_RPM=10
# Reasoning token budget. 0 disables thinking, which is right for extraction.
FACTLAYER_GEMINI_THINKING=0

# --- Alternative backends --------------------------------------------------
ANTHROPIC_API_KEY=

# --- Tuning ----------------------------------------------------------------
FACTLAYER_DB=data/factlayer.db
FACTLAYER_MAX_CONCURRENCY=4
# Hard cap on LLM extraction units per document. Highest-density units win.
# This is a budget control, not a correctness mechanism; 0 means no cap.
FACTLAYER_MAX_UNITS_PER_DOC=60
